class Solution {
    public int thirdMax(int[] nums) {

        int  max1 = Integer.MIN_VALUE;
        int  max2 = Integer.MIN_VALUE;
        int  max3 = Integer.MIN_VALUE;

        for (int arr : nums) {
            if (arr == max1 || arr == max2 || arr == max3) {
                continue;
            }
               if (arr > max1) {
                max3 = max2;
                max2 = max1;
                max1 = arr;
            }
            else if (arr > max2) {
                max3 = max2;
                max2 = arr;
            }
            else if (arr > max3) {
                max3 = arr;
            }
        }

        if (max3 == Integer.MIN_VALUE) {
            return max1;
        }

        return max3;
    }
}
