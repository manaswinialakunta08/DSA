class Solution {
    public boolean canVisitAllRooms(List<List<Integer>> rooms) {
    
        int v = rooms.size();
        ArrayList<Integer> res = new ArrayList<>();
        boolean [] vis = new boolean[v];
        Queue<Integer> q = new LinkedList<>();
        vis[0] = true;
        q.add(0);
        while(!q.isEmpty())
        {
            int curr = q.poll();
            res.add(curr);
            for(int x:rooms.get(curr))
            {
                if(!vis[x])
                {
                    vis[x] = true;
                    q.add(x);
                }
            }
            
        }
        for(int i = 0; i < v ;i++)
        {
            if(!vis[i])
            {
                return false;
            }
        }
        return true;
 
        
    }
}
