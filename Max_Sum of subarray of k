class Solution {
    public int maxSubarraySum(int[] arr, int k) {
        // Code here
        int windowsum = 0;
        int maxsum = 0;
        for (int i =0 ; i < k ; i ++)
        {
            windowsum = windowsum + arr[i];
        }
        maxsum = windowsum ;
        for ( int i = k ; i < arr.length ; i++)
        {
            windowsum = windowsum + arr[i] - arr[ i - k];
        
        if (windowsum > maxsum )
        {
            maxsum = windowsum;
        }
        }
           return maxsum;
    }
  
}
